{
	"name": "fastwork-sveltekit",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "!",
		"npm": "!",
		"yarn": "!",
		"pnpm": "!",
		"bun": ">=1.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "bunx --bun vitest",
		"test": "bun test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.6",
		"@eslint/js": "^9.20.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.17.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"eslint": "^9.20.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.5.1",
		"prettier-plugin-svelte": "^3.3.3",
		"sass": "^1.85.0",
		"svelte": "^5.20.1",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.1.4",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.1",
		"vite": "^6.1.0",
		"vitest": "^3.0.5"
	},
	"dependencies": {
		"@fastwork/sdk": "^1.0.1",
		"@fastwork/turbine-css": "2.0.2",
		"@fastwork/turbine-theme": "2.0.3",
		"@fontsource/kanit": "^5.1.1",
		"@zerodevx/svelte-toast": "^0.9.6",
		"dayjs": "^1.11.13",
		"linkify-html": "^4.2.0",
		"linkifyjs": "^4.2.0",
		"lodash-es": "^4.17.21",
		"marked": "^15.0.7",
		"strapi-sdk-js": "^2.3.3",
		"sveltekit-i18n": "^2.4.2",
		"sweetalert2": "^11.17.2",
		"ts-dedent": "^2.2.0"
	}
}
